/* 全局样式 */
page {
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', sans-serif;
  background: #f5f5f5;
  color: #333;
}

.container {
  padding: 20rpx;
}

.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
}

.btn-primary {
  background: linear-gradient(135deg, #1a73e8, #4a9af5);
  color: #fff;
  border: none;
  border-radius: 12rpx;
  font-size: 32rpx;
  padding: 24rpx;
}

.btn-primary[disabled] {
  background: #ccc;
}

.tag {
  display: inline-block;
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
  margin-right: 8rpx;
}

.tag-chong {
  background: #ffeaea;
  color: #e53e3e;
}

.tag-wen {
  background: #fff8e1;
  color: #f59e0b;
}

.tag-bao {
  background: #e8f5e9;
  color: #2e7d32;
}

/* ── 招生政策标记 ── */
.policy-badges {
  display: flex;
  flex-wrap: wrap;
  margin-top: 12rpx;
  gap: 8rpx;
}

.policy-badge {
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
  background: #f0f0f0;
  color: #666;
}

.policy-badge.rule-safe {
  background: #e8f5e9;
  color: #2e7d32;
}

.policy-badge.rule-warn {
  background: #fff8e1;
  color: #e65100;
}

.policy-badge.rule-danger {
  background: #ffebee;
  color: #c62828;
}

.policy-badge.subj-badge {
  background: #e3f2fd;
  color: #1565c0;
}

/* ── 详细页 ── */
.policy-card {
  background: #fffef5;
  border: 1rpx solid #ffcc02;
}

.policy-rule-item {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.policy-rule-item:last-child {
  border-bottom: none;
}

.policy-rule-icon {
  font-size: 36rpx;
  margin-right: 16rpx;
}

.policy-rule-text {
  font-size: 28rpx;
  color: #333;
}

.policy-rule-sub {
  font-size: 24rpx;
  color: #888;
  margin-top: 4rpx;
}
