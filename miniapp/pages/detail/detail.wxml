<!-- 院校详情页 -->
<view class="container">
  <view class="loading" wx:if="{{loading}}">
    <text>加载中...</text>
  </view>

  <block wx:if="{{!loading && uni}}">
    <!-- 头部 -->
    <view class="detail-header">
      <text class="uni-name">{{uni.name}}</text>
      <view class="uni-tags">
        <text class="tag-level">{{uni.level || '本科'}}</text>
        <text class="tag-type">{{uni.type}}</text>
        <text class="tag-city">{{uni.city}}</text>
        <text wx:if="{{uni.is_public}}" class="tag-public">公办</text>
        <text wx:else class="tag-private">民办</text>
      </view>
    </view>

    <!-- 录取历史 -->
    <view class="card">
      <text class="section-title">📊 近三年录取数据</text>
      <text class="section-sub">{{province}} · {{category}}</text>
      <view class="history-table" wx:if="{{history.length > 0}}">
        <view class="history-row header">
          <text class="h-cell">年份</text>
          <text class="h-cell">批次</text>
          <text class="h-cell">最低分</text>
          <text class="h-cell">最低位次</text>
        </view>
        <view class="history-row" wx:for="{{history}}" wx:key="year">
          <text class="h-cell">{{item.year}}</text>
          <text class="h-cell">{{item.batch}}</text>
          <text class="h-cell score">{{item.min_score}}</text>
          <text class="h-cell">{{item.min_rank || '—'}}</text>
        </view>
      </view>
      <text class="empty" wx:else>暂无该省份录取数据</text>
    </view>

    <!-- 优势专业 -->
    <view class="card" wx:if="{{majors.length > 0}}">
      <text class="section-title">🎯 优势专业</text>
      <view class="major-item" wx:for="{{majors}}" wx:key="name">
        <view class="major-header">
          <text class="major-name">{{item.name}}</text>
          <text wx:if="{{item.is_advantage}}" class="badge-adv">优势专业</text>
        </view>
        <view class="major-meta">
          <text class="meta">{{item.category}}</text>
          <text wx:if="{{item.employment_score}}" class="meta">就业评分 {{item.employment_score}}</text>
          <text wx:if="{{item.avg_salary}}" class="meta">均薪 ¥{{item.avg_salary}}</text>
        </view>
      </view>
    </view>

    <!-- 招生政策 -->
    <view class="card policy-card" wx:if="{{policy}}">
      <text class="section-title">📋 招生政策</text>
      
      <view class="policy-rule-item">
        <text class="policy-rule-icon">
          {{policy.admission_rule === '分数清' ? '📊' : policy.admission_rule === '专业清' ? '🔴' : '⚠️'}}
        </text>
        <view>
          <text class="policy-rule-text">{{policy.admission_rule === '分数清' ? '分数优先' : policy.admission_rule === '专业清' ? '专业优先' : '级差录取'}}</text>
          <text wx:if="{{policy.grade_diff}}" class="policy-rule-sub">级差分值：{{policy.grade_diff}} — 每往后一个专业志愿，实际分数递减（前两个专业最关键）</text>
          <text wx:elif="{{policy.admission_rule === '专业清'}}" class="policy-rule-sub">按专业志愿顺序录取，第一志愿不录取则可能调剂，填报需谨慎</text>
          <text wx:elif="{{policy.admission_rule === '分数清'}}" class="policy-rule-sub">所有考生按总分排队，高分优先选择专业，最安全的录取模式</text>
        </view>
      </view>

      <view class="policy-rule-item" wx:if="{{policy.subject_requirements}}">
        <text class="policy-rule-icon">📝</text>
        <view>
          <text class="policy-rule-text">单科要求</text>
          <text class="policy-rule-sub" wx:for="{{policy.subject_requirements}}" wx:for-item="val" wx:for-index="key" wx:key="key">{{key}} ≥ {{val}}分 · </text>
        </view>
      </view>

      <view class="policy-rule-item" wx:if="{{policy.physical_restrictions.length > 0}}">
        <text class="policy-rule-icon">🏥</text>
        <view>
          <text class="policy-rule-text">体检限制</text>
          <text class="policy-rule-sub" wx:for="{{policy.physical_restrictions}}" wx:key="*this">{{item}} · </text>
        </view>
      </view>

      <view class="policy-rule-item">
        <text class="policy-rule-icon">➕</text>
        <view>
          <text class="policy-rule-text">加分政策</text>
          <text class="policy-rule-sub">{{policy.bonus_policy || '无特殊政策'}}</text>
        </view>
      </view>

      <view class="policy-rule-item" wx:if="{{policy.special_plans.length > 0}}">
        <text class="policy-rule-icon">🎫</text>
        <view>
          <text class="policy-rule-text">专项计划</text>
          <text class="policy-rule-sub" wx:for="{{policy.special_plans}}" wx:key="*this">{{item}} · </text>
        </view>
      </view>
    </view>

    <!-- 报考须知（无政策数据时显示） -->
    <view class="card policy-card" wx:else>
      <text class="section-title">📋 报考须知</text>
      <text class="policy-text">• 以上录取数据仅供参考，每年分数线会因报考人数、试题难度等因素波动，请以官方公布为准</text>
      <text class="policy-text">• 建议查阅该校招生官网了解具体专业录取规则</text>
      <text class="policy-text">• 位次法的参考价值通常高于分数法，建议以位次为主要参考依据</text>
    </view>
  </block>
</view>
