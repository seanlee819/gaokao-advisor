.header {
  text-align: center;
  padding: 40rpx 0 20rpx;
}
.title {
  display: block;
  font-size: 48rpx;
  font-weight: 700;
  color: #1a73e8;
}
.subtitle {
  display: block;
  font-size: 26rpx;
  color: #999;
  margin-top: 8rpx;
}
.disclaimer {
  background: #fff8e1;
  border-left: 6rpx solid #ff9800;
  border-radius: 8rpx;
  padding: 16rpx 20rpx;
  margin-bottom: 20rpx;
  display: flex;
  align-items: flex-start;
}
.disclaimer-icon {
  font-size: 28rpx;
  margin-right: 10rpx;
  flex-shrink: 0;
}
.disclaimer-text {
  font-size: 22rpx;
  color: #e65100;
  line-height: 36rpx;
}
.bold {
  font-weight: 700;
}
.form-row {
  margin-bottom: 30rpx;
}
.label {
  display: block;
  font-size: 28rpx;
  color: #666;
  margin-bottom: 12rpx;
}
.input {
  border: 2rpx solid #e0e0e0;
  border-radius: 12rpx;
  padding: 20rpx;
  font-size: 32rpx;
}
.picker {
  border: 2rpx solid #e0e0e0;
  border-radius: 12rpx;
  padding: 20rpx;
  font-size: 32rpx;
  color: #333;
}
.radio-group {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}
.radio {
  display: flex;
  align-items: center;
  font-size: 28rpx;
}
.loading {
  text-align: center;
  padding: 40rpx;
  color: #999;
}
.tips {
  margin-top: 20rpx;
}
.tips-title {
  font-size: 30rpx;
  font-weight: 600;
  display: block;
  margin-bottom: 16rpx;
}
.tips-text {
  display: block;
  font-size: 26rpx;
  color: #888;
  line-height: 44rpx;
}

/* ── 升级横幅 ── */
.upgrade-banner {
  background: linear-gradient(135deg, #fff7e6, #fff3d6);
  border: 2rpx solid #ffc107;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 20rpx;
  display: flex;
  align-items: center;
}
.upgrade-banner.login-banner {
  background: linear-gradient(135deg, #e8f0fe, #d2e3fc);
  border-color: #1a73e8;
}
.upgrade-icon {
  font-size: 40rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
}
.upgrade-text {
  flex: 1;
}
.upgrade-title {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
}
.upgrade-desc {
  display: block;
  font-size: 24rpx;
  color: #e65100;
  margin-top: 4rpx;
}
.login-banner .upgrade-desc {
  color: #1a73e8;
}
