.header {
  text-align: center;
  padding: 60rpx 0 30rpx;
}
.title {
  display: block;
  font-size: 44rpx;
  font-weight: 700;
}
.subtitle {
  display: block;
  font-size: 26rpx;
  color: #999;
  margin-top: 8rpx;
}
.form-row {
  margin-bottom: 24rpx;
}
.label {
  display: block;
  font-size: 28rpx;
  color: #666;
  margin-bottom: 10rpx;
}
.input {
  border: 2rpx solid #e0e0e0;
  border-radius: 12rpx;
  padding: 20rpx;
  font-size: 32rpx;
}
.switch-text {
  text-align: center;
  color: #1a73e8;
  font-size: 26rpx;
  margin-top: 20rpx;
}
.user-card {
  text-align: center;
  padding: 40rpx;
}
.user-name {
  display: block;
  font-size: 36rpx;
  font-weight: 600;
}
.user-tier {
  display: inline-block;
  margin-top: 12rpx;
  padding: 8rpx 24rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
  color: #fff;
}
.user-tier.free { background: #1a73e8; }
.user-stats {
  margin-top: 16rpx;
  font-size: 26rpx;
  color: #999;
}
.section-title {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 20rpx;
}
.btn-logout {
  margin-top: 30rpx;
  background: #fff;
  color: #e53e3e;
  border: 2rpx solid #e53e3e;
  border-radius: 12rpx;
  font-size: 28rpx;
}

/* 查询历史 */
.history-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}
.history-item:last-child {
  border-bottom: none;
}
.history-info {
  flex: 1;
}
.history-main {
  display: block;
  font-size: 28rpx;
  color: #333;
}
.history-sub {
  display: block;
  font-size: 24rpx;
  color: #999;
  margin-top: 4rpx;
}
.history-arrow {
  font-size: 28rpx;
  color: #ccc;
}
