.header {
  text-align: center;
  padding: 60rpx 0 30rpx;
}
.title {
  display: block;
  font-size: 44rpx;
  font-weight: 700;
}
.subtitle {
  display: block;
  font-size: 26rpx;
  color: #999;
  margin-top: 8rpx;
}
.form-row {
  margin-bottom: 24rpx;
}
.label {
  display: block;
  font-size: 28rpx;
  color: #666;
  margin-bottom: 10rpx;
}
.input {
  border: 2rpx solid #e0e0e0;
  border-radius: 12rpx;
  padding: 20rpx;
  font-size: 32rpx;
}
.switch-text {
  text-align: center;
  color: #1a73e8;
  font-size: 26rpx;
  margin-top: 20rpx;
}
.user-card {
  text-align: center;
  padding: 40rpx;
}
.user-name {
  display: block;
  font-size: 36rpx;
  font-weight: 600;
}
.user-tier {
  display: inline-block;
  margin-top: 12rpx;
  padding: 8rpx 24rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
  color: #fff;
}
.user-tier.free { background: #888; }
.user-tier.enhanced { background: #1a73e8; }
.user-tier.complete { background: linear-gradient(135deg, #ff8c00, #ff6d00); }
.user-stats {
  margin-top: 16rpx;
  font-size: 26rpx;
  color: #999;
}
.section-title {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 20rpx;
}
.plan {
  border: 2rpx solid #e0e0e0;
  border-radius: 12rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
}
.plan-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}
.plan-name { font-size: 30rpx; font-weight: 600; }
.plan-price { font-size: 36rpx; font-weight: 700; color: #1a73e8; }
.plan-desc { font-size: 24rpx; color: #888; display: block; margin-bottom: 16rpx; }
.plan-features {
  margin-bottom: 16rpx;
}
.plan-features text {
  display: block;
  font-size: 24rpx;
  color: #666;
  line-height: 36rpx;
}
.btn-upgrade {
  background: #1a73e8;
  color: #fff;
  border: none;
  border-radius: 8rpx;
  font-size: 28rpx;
  padding: 16rpx;
}
.btn-upgrade.gold {
  background: linear-gradient(135deg, #ff8c00, #ff6d00);
}
.pay-note {
  display: block;
  text-align: center;
  font-size: 24rpx;
  color: #999;
  margin-top: 12rpx;
}
.crown {
  display: block;
  font-size: 64rpx;
  text-align: center;
}
.desc {
  display: block;
  text-align: center;
  font-size: 26rpx;
  color: #888;
}
.btn-logout {
  margin-top: 30rpx;
  background: #fff;
  color: #e53e3e;
  border: 2rpx solid #e53e3e;
  border-radius: 12rpx;
  font-size: 28rpx;
}

/* ── 升级弹窗 ── */
.modal {
  position: fixed;
  top: 0; left: 0;
  width: 100%; height: 100%;
  background: rgba(0,0,0,0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 999;
}
.modal-content {
  background: #fff;
  border-radius: 20rpx;
  padding: 40rpx 30rpx;
  width: 600rpx;
  max-height: 80vh;
  overflow-y: auto;
}
.modal-title {
  display: block;
  font-size: 34rpx;
  font-weight: 700;
  text-align: center;
}
.modal-price {
  display: block;
  text-align: center;
  font-size: 56rpx;
  font-weight: 700;
  color: #1a73e8;
  margin: 16rpx 0 30rpx;
}
.modal-steps {
  margin-bottom: 20rpx;
}
.step {
  display: block;
  font-size: 26rpx;
  color: #333;
  line-height: 44rpx;
  margin-bottom: 8rpx;
}
.step.code {
  background: #f5f5f5;
  padding: 12rpx 20rpx;
  border-radius: 8rpx;
  font-family: monospace;
  font-size: 28rpx;
  color: #1a73e8;
  text-align: center;
  margin: 8rpx 0;
}
.step.hint {
  color: #999;
  font-size: 24rpx;
  text-align: center;
}
.btn-copy {
  background: #f0f0f0;
  border: none;
  border-radius: 8rpx;
  font-size: 26rpx;
  padding: 12rpx;
  margin: 8rpx 0 16rpx;
}
.btn-close {
  background: #1a73e8;
  color: #fff;
  border: none;
  border-radius: 12rpx;
  font-size: 28rpx;
  padding: 20rpx;
  margin-top: 10rpx;
}
.crown-card {
  text-align: center;
  padding: 40rpx;
}

/* ── 查询历史 ── */
.history-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}
.history-item:last-child {
  border-bottom: none;
}
.history-info {
  flex: 1;
}
.history-main {
  display: block;
  font-size: 28rpx;
  color: #333;
}
.history-sub {
  display: block;
  font-size: 24rpx;
  color: #999;
  margin-top: 4rpx;
}
.history-arrow {
  font-size: 28rpx;
  color: #ccc;
}
