.result-header {
  background: linear-gradient(135deg, #1a73e8, #4a9af5);
  color: #fff;
  padding: 40rpx;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
  text-align: center;
}
.score-badge {
  display: block;
  font-size: 64rpx;
  font-weight: 700;
}
.info-text {
  display: block;
  font-size: 26rpx;
  opacity: 0.9;
  margin-top: 8rpx;
}
.tabs {
  display: flex;
  background: #fff;
  border-radius: 12rpx;
  margin-bottom: 20rpx;
  overflow: hidden;
}
.tab {
  flex: 1;
  text-align: center;
  padding: 24rpx 0;
  font-size: 28rpx;
  color: #666;
}
.tab.active {
  color: #1a73e8;
  font-weight: 600;
  border-bottom: 4rpx solid #1a73e8;
}
.school-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}
.school-name {
  font-size: 32rpx;
  font-weight: 600;
}
.school-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 20rpx;
}
.meta-item {
  font-size: 24rpx;
  color: #888;
  background: #f5f5f5;
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
}
.tag-public {
  color: #1a73e8;
  background: #e8f0fe;
}
.school-scores {
  display: flex;
  justify-content: space-around;
  border-top: 1rpx solid #f0f0f0;
  padding-top: 20rpx;
}
.score-item {
  text-align: center;
}
.score-label {
  display: block;
  font-size: 22rpx;
  color: #999;
}
.score-value {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
}
.empty {
  text-align: center;
  padding: 80rpx;
  color: #999;
}
.disclaimer-foot {
  text-align: center;
  padding: 30rpx 20rpx;
  font-size: 22rpx;
  color: #999;
  line-height: 36rpx;
}
